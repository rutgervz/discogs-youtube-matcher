{
  "manifest_version": 3,
  "name": "Discogs YouTube Matcher",
  "version": "0.35",
  "description": "Discogs and YouTube in both directions: play tracklists on Discogs, and see on YouTube, Spotify and Beatport whether a track is for sale on vinyl.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.discogs.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.discogs.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "vinyl-panel.js",
        "yt-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "vinyl-panel.js",
        "spotify-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.beatport.com/*"
      ],
      "js": [
        "vinyl-panel.js",
        "beatport-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
